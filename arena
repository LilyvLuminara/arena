-- ========== TOGGLE GUI ==========
local isOpen = false

function toggleGUI()
    isOpen = not isOpen
    if isOpen then
        mainFrame.Visible = true
        mainFrame.Position = UDim2.new(0.5, -160, 0.5, -185)
    else
        mainFrame.Visible = false
        aboutFrame.Visible = false
    end
end

local iconClickStart = nil
local iconDragDetected = false
local CLICK_THRESHOLD = 15

iconFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
       input.UserInputType == Enum.UserInputType.Touch then
        iconClickStart = input.Position
        iconDragDetected = false
    end
end)

iconFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or
       input.UserInputType == Enum.UserInputType.Touch then
        if iconClickStart then
            local delta = (input.Position - iconClickStart).Magnitude
            if delta > CLICK_THRESHOLD then
                iconDragDetected = true
            end
        end
    end
end)

iconFrame.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
       input.UserInputType == Enum.UserInputType.Touch then
        if not iconDragDetected and iconClickStart then
            toggleGUI()
        end
        iconClickStart = nil
        iconDragDetected = false
    end
end)

