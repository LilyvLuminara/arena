-- ========== INFINITE YIELD (ANTI AFK/KICK) - IMPROVED ==========
local infiniteYieldActive = false
local yieldTimerConnection = nil
local yieldConnections = {}
local yieldLoopRunning = false

local function simulateClick()
    pcall(function()
        -- Method 1: VirtualUser Click (Paling ampuh)
        if virtualUser then
            virtualUser:CaptureController()
            virtualUser:ClickButton2(Vector2.new())
            virtualUser:ClickButton1(Vector2.new())
            
            -- Simulasi klik di berbagai posisi
            for i = 1, 3 do
                virtualUser:ClickButton2(Vector2.new(
                    math.random(100, 500),
                    math.random(100, 500)
                ))
                task.wait(0.05)
            end
        end
        
        -- Method 2: Simulate keyboard input
        if userInputService then
            -- Simulate pressing random keys (non-intrusive)
            local keys = {
                Enum.KeyCode.W,
                Enum.KeyCode.A,
                Enum.KeyCode.S,
                Enum.KeyCode.D,
                Enum.KeyCode.Space,
                Enum.KeyCode.LeftShift
            }
            local randomKey = keys[math.random(1, #keys)]
            userInputService:SetKeyDown(randomKey)
            task.wait(0.1)
            userInputService:SetKeyUp(randomKey)
        end
        
        -- Method 3: Mouse movement simulation
        if userInputService then
            local x = math.random(0, 1920)
            local y = math.random(0, 1080)
            userInputService:SetMouseLocation(x, y)
            
            -- Gerakan mouse secara acak
            for i = 1, 5 do
                x = x + math.random(-50, 50)
                y = y + math.random(-50, 50)
                userInputService:SetMouseLocation(
                    math.clamp(x, 0, 1920),
                    math.clamp(y, 0, 1080)
                )
                task.wait(0.02)
            end
        end
    end)
end

local function activateInfiniteYield()
    if infiniteYieldActive then return end
    print("🔄 ACTIVATING INFINITE YIELD (IMPROVED)...")
    infiniteYieldActive = true
    
    -- Initial setup
    pcall(function()
        if virtualUser then
            virtualUser:CaptureController()
        end
    end)
    
    -- Click every 8-13 seconds (lebih agresif & random)
    local function clickLoop()
        while infiniteYieldActive do
            simulateClick()
            
            -- Variasi waktu agar tidak terdeteksi pattern
            local waitTime = 8 + math.random(0, 5)
            task.wait(waitTime)
        end
    end
    
    -- Start click loop di thread terpisah
    task.spawn(clickLoop)
    
    -- Backup timer setiap 10 detik
    yieldTimerConnection = runService.Heartbeat:Connect(function()
        if infiniteYieldActive then
            if tick() % 10 < 0.1 then
                simulateClick()
            end
        end
    end)
    
    -- Extra protection: simulate activity when character spawns
    local characterConn
    characterConn = player.CharacterAdded:Connect(function()
        task.wait(1)
        simulateClick()
    end)
    table.insert(yieldConnections, characterConn)
    
    -- Extra: simulate click when game is idle
    local idleConn
    idleConn = userInputService.InputBegan:Connect(function()
        if infiniteYieldActive then
            -- Auto respond to any input with a click
            task.wait(0.5)
            simulateClick()
        end
    end)
    table.insert(yieldConnections, idleConn)
    
    print("✅ INFINITE YIELD ACTIVATED! (Click every 8-13 seconds)")
end

local function deactivateInfiniteYield()
    if not infiniteYieldActive then return end
    infiniteYieldActive = false
    
    if yieldTimerConnection then
        yieldTimerConnection:Disconnect()
        yieldTimerConnection = nil
    end
    
    for _, conn in pairs(yieldConnections) do
        pcall(conn.Disconnect, conn)
    end
    yieldConnections = {}
    
    print("⏹ INFINITE YIELD DEACTIVATED")
end

-- ========== LOOP ==========
local isRunning = false
local loopConnection = nil
local frameCount = 0

local function startLoop()
    if isRunning then return end
    isRunning = true
    
    loopConnection = runService.Heartbeat:Connect(function()
        if isRunning then
            frameCount = frameCount + 1
            sendClick()
            sendSpeed(CLICK_SPEED)
            
            if frameCount % 100 == 0 then
                collectgarbage("collect")
                collectgarbage("step")
            end
        end
    end)
    print("🔥 LOOP ACTIVE!")
end

local function stopLoop()
    isRunning = false
    if loopConnection then
        loopConnection:Disconnect()
        loopConnection = nil
    end
    print("⏹ LOOP STOPPED")
end

